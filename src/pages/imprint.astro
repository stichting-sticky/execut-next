---
import { getCollection, getEntry } from "astro:content";

import Layout from "@layouts/Base.astro";

import Banner from "@components/Banner.astro";
import Button from "@components/Button.astro";
import Container from "@components/Container.astro";

import { sort } from "@utils";

const editions = await getCollection("editions").then(sort);

const current = editions.at(0)!;

const { name, date, tickets, notification, venue } = current.data;
---

<Layout class="from-primary/80 via-accent/60 to-subtle-highlight dark:bg-primary-lighter dark:via-accent-lighter/80 dark:to-foreground-highlight bg-linear-to-tl via-25% to-50%">
  <main class="-mt-22 flex min-h-screen items-end-safe justify-around overflow-hidden pt-22 pb-8 will-change-transform sm:items-center">
    <div class="@container relative z-10 flex max-w-lg flex-1 flex-col gap-4">
      <Container>
        <heading class="block font-mono leading-14 font-bold *:bg-white/40 *:-m-2 *:px-2 *:first:pt-2 *:last:pb-2 sm:leading-18">
          <span class="text-primary text-4xl sm:text-5xl">
            {name}
            <br />
          </span>

          {date && (
            <span class="text-primary-lighter text-4xl sm:text-5xl">
              {new Intl.DateTimeFormat("en-GB", {
                day: "numeric",
                month: "long",
              }).format(date)}
              <br />
            </span>
          )}

          {venue && (
            <span class="text-primary-highlight text-4xl sm:text-5xl">
              {await getEntry(venue).then((venue) => venue.data.name)}
              <br />
            </span>
          )}
        </heading>
      </Container>

      {notification && <Banner {...notification} />}

      <Container>
        <div class="*:bg-secondary/80 *:dark:bg-secondary-lighter/80 mb-2 flex flex-col gap-2 text-center *:backdrop-blur sm:mb-4 sm:gap-4">
          {tickets && (
            <Button as="a" href={tickets}>
              <span class="block p-1 text-xl sm:p-2">Get your ticket!</span>
            </Button>
          )}

          <Button as="a" href="https://www.instagram.com/execut_conferenc">
            <span class="block p-1 text-xl sm:p-2">Instagram</span>
          </Button>

          <Button as="a" href="https://www.linkedin.com/company/execut-conference">
            <span class="block p-1 text-xl sm:p-2">LinkedIn</span>
          </Button>
        </div>
      </Container>
    </div>

    <div class="absolute inset-0 -bottom-24 -left-2/3 sm:left-0 opacity-80 dark:opacity-60">
      <iframe
        class="size-full"
        loading="lazy"
        title="exec(ut) logo"
        src="https://my.spline.design/glasscube-CmxGfmC2hMcKu65tdK70LS5N" />
    </div>
  </main>
</Layout>
